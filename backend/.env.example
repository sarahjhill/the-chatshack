# Copy this file to .env for local development (never commit the real .env).
# In production (Heroku), set these as Config Vars instead - see README.md.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DATABASE_URL unset locally to use sqlite. On Heroku this is set
# automatically when you add the Postgres add-on.
# DATABASE_URL=postgres://...

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email - leave EMAIL_BACKEND unset locally to just print emails to the
# console. In production, point this at a real SMTP provider.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your-provider-api-key
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@thechatshack.app

# Who gets notified by email for new form submissions and shift sign-ups.
NOTIFY_EMAIL=enquiries.the.chatshack01@gmail.com

# Image uploads in admin (photos, logos) are stored on Cloudinary's free
# tier rather than on disk - Heroku wipes its own disk on every deploy.
# Create a free account at cloudinary.com, then copy these three values
# from your Cloudinary Dashboard. Leave unset locally if you don't need
# to test image uploads - everything else works fine without them.
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# Stripe - powers the "Buy an item" checkout on the Donate page. Use your
# test keys (pk_test_/sk_test_) from the Stripe Dashboard > Developers >
# API keys while building; switch to live keys only once ready to accept
# real payments. On Heroku, set these three as Config Vars instead.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# FRONTEND_URL=https://chatshack.app
