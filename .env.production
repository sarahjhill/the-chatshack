# Used by the GitHub Actions build (npm run build) when baking the live
# site. api.chatshack.app is a CNAME pointing at the Heroku app (see
# backend/README.md) - if it's not resolving yet, the homepage/forms just
# fall back gracefully to the static content, so it's safe to point here
# ahead of DNS finishing propagation.
VITE_API_URL=https://api.chatshack.app

# Google Analytics 4 measurement ID for chatshack.app - only loads after a
# visitor accepts the cookie banner (see src/lib/analytics.ts). Not set in
# the plain .env, so local development never sends data to Google.
VITE_GA_MEASUREMENT_ID=G-D459QDB4MN
